# === Gemini Configuration ===
GEMINI_API_KEY="your_gemini_api_key_here"
MODEL_NAME="gemini_model_name_here"  # e.g., gemini-2.0-flash

# === GitHub Integration ===
GITHUB_API_KEY="your_github_api_key_here"

# === Search Configuration ===
TOP_N_RESULTS=10  # Number of search results to return
DATA_PATH="path_to_your_data_file.json"  # e.g., data/final.json
VECTOR_DB_PATH="path_to_your_vector_db.faiss"  # e.g., data/final_vector_db.faiss

# === Hybrid Search Weights ===
TFIDF_WEIGHT=0.3
BM25_WEIGHT=0.3
EMBEDDING_WEIGHT=0.4

DEFAULT_SEARCH_METHOD="hybrid"  # Options: hybrid, tfidf, bm25, embedding

# === Flask Configuration ===
DEBUG=true  # true or false
HOST="0.0.0.0"
PORT=5000

# === Embedding Model ===
EMBEDDING_MODEL="embedding_model_name_here"  # e.g., asafaya/bert-base-arabic

# === LLM Provider Configuration ===
LLM_PROVIDER="gemini"  # Options: gemini or deepseek

# === DeepSeek Configuration ===
DEEPSEEK_BASE_URL="http://your_deepseek_host:port"  # e.g., http://10.80.11.107:11434
DEEPSEEK_MODEL_NAME="deepseek_model_name_here"  # e.g., deepseek-r1:70b
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# === Authentication ===
JWT_TOKEN="your_jwt_token_here"

# === LLM Behavior Settings ===
TEMPERATURE=0.7  # Controls randomness (0.0 = deterministic, 1.0 = creative)
MAX_TOKENS=8192  # Maximum tokens the model can generate

# === Conversation Management ===
MAX_CONVERSATION_LENGTH=20  # Max number of messages stored in a conversation
CONVERSATION_EXPIRY_TIME=3600  # Time in seconds before a conversation expires
